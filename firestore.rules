rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Master collections: Cho phép người học đọc công khai
    match /grammar_points/{grammarId} {
      allow read: if true;
      allow write: if false;
    }

    match /kanji_dict/{character} {
      allow read: if true;
      allow write: if false;
    }

    match /curriculum/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // 2. Dữ liệu học tập cá nhân: Chỉ người sở hữu được đọc/ghi
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
